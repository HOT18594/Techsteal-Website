# dependencies
/node_modules
/.pnp
.pnp.*

# lockfiles — bun.lock is canonical; ignore npm's lock so the two can't
# drift / confuse Vercel's package-manager auto-detection
package-lock.json
bun.lockb

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
build.log

# env files (keep .env.example tracked)
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel
.vercel-token

# deployment tooling secrets reference (CODES.md lists values — keep local)
scripts/CODES.md

# keep ignoring any env variant (incl. .env.example copies)
.env*
