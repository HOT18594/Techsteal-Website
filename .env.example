# ------------------------------------------------------------------
# TECHSTEAL website — environment variables
# Copy this file to `.env.local` and fill in your values.
# On Vercel, set these in Project → Settings → Environment Variables.
# ------------------------------------------------------------------

# --- Session signing (JWT) — REQUIRED for login to persist -------------
# Generate a strong random value, e.g. `openssl rand -base64 32`.
# On Vercel the old project already has SESSION_SECRET set.
# In production this is REQUIRED: without it, session auth refuses to run
# (fail closed) rather than trusting a public default.
SESSION_SECRET="change-me-to-a-random-string"

# --- Admin unlock code --------------------------------------------------
# The code that lets a signed-in member promote themselves to admin during
# onboarding / in Profile & Settings. It used to be hardcoded in the
# (public) repo — it now MUST come from this env var in production.
# Generate something long and random, e.g. `openssl rand -hex 12`.
ADMIN_CODE=""

# --- Database (optional - content falls back to placeholders) ----------
# Recommended: Supabase (https://supabase.com) — free tier is plenty.
#
# 1. Create a project, open Project Settings → Database → Connection string.
# 2. Pick the "Session pooler" tab (port 5432) and copy the URI.
# 3. Replace [YOUR-PASSWORD] with the database password you set.
#
# It looks like:
#   postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# The "Direct connection" string also works.
DATABASE_URL="postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# --- Minecraft server status ----------------------------------------
# Address shown on the site and queried against mcsrvstat.us for live status.
MINECRAFT_SERVER="play.techsteal.space"
MINECRAFT_PORT="25565"

# --- Supabase Storage (gallery image uploads) -------------------------
# Project URL (https://<ref>.supabase.co) and the secret service-role key
# (Supabase > Settings > API). Server-only — never expose the service role
# key to the client. Create a PUBLIC bucket named "gallery" in the dashboard
# (Storage > New bucket) the first time.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI assistant (optional) ----------------------------------------
# Leave AI_API_KEY empty to run the assistant in "not connected" mode.
# Any OpenAI-compatible /chat/completions endpoint works.
# AI_MODEL is the primary model (defaults to minimax/minimax-m3:free).
# AI_FALLBACK_MODEL is used when the primary is rate-limited or fails
# (defaults to nvidia/nemotron-3-super-120b-a12b:free).
AI_API_KEY=""
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL="minimax/minimax-m3:free"
AI_FALLBACK_MODEL="nvidia/nemotron-3-super-120b-a12b:free"

# --- Discord OAuth (login) -------------------------------------------
# Create an app at https://discord.com/developers/applications →
# "OAuth2" tab → copy Client ID and Client Secret.
# Redirect URIs to register in the Discord app (both!):
#   http://localhost:3000/api/auth/discord/callback
#   https://www.techsteal.space/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- Discord server verification (onboarding) ------------------------
# Lets users verify they're members of the official server.
#   DISCORD_BOT_TOKEN  — a bot token for an app that's IN your server
#   DISCORD_GUILD_ID   — the server's ID (right-click server → Copy Server ID)
# Without these, onboarding offers "skip" and the profile shows unverified.
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""

# --- App -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
