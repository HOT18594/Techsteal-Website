# ------------------------------------------------------------------
# TECHSTEAL website — environment variables
# Copy this file to `.env.local` and fill in your values.
# On Vercel, set these in Project → Settings → Environment Variables.
# ------------------------------------------------------------------

# --- Session signing (JWT) — REQUIRED for login to persist -------------
# Generate a strong random value, e.g. `openssl rand -base64 32`.
# On Vercel the old project already has SESSION_SECRET set.
# In production this is REQUIRED: without it, session auth refuses to run
# (fail closed) rather than trusting a public default.
SESSION_SECRET="change-me-to-a-random-string"

# --- Admin unlock code --------------------------------------------------
# The code that lets a signed-in member promote themselves to admin during
# onboarding / in Profile & Settings. It used to be hardcoded in the
# (public) repo — it now MUST come from this env var in production.
# Generate something long and random, e.g. `openssl rand -hex 12`.
# Leave empty to disable admin unlocking in production (local dev falls back
# to the legacy constant in src/lib/admin-code.ts).
ADMIN_CODE=""
# Legacy alias for the same value (the name the Vercel project was originally
# set up with). Only read when ADMIN_CODE is completely unset — an empty
# ADMIN_CODE="" above still takes precedence. New setups should use ADMIN_CODE.
# ADMIN_UNLOCK_CODE=""

# --- Database (optional - content falls back to placeholders) ----------
# Recommended: Supabase (https://supabase.com) — free tier is plenty.
#
# 1. Create a project, open Project Settings → Database → Connection string.
# 2. Pick the "Session pooler" tab (port 5432) and copy the URI.
# 3. Replace [YOUR-PASSWORD] with the database password you set.
# 4. Uncomment the example below and put your URI there.
#
# Leave DATABASE_URL empty to run without a database: every content API falls
# back to src/lib/fallback-data.ts and the site still renders. A non-empty but
# wrong URL is worse than empty — it disables that fallback, so every content
# request first pays a failing database round trip.
#
# Example (Session pooler; a "Direct connection" URI also works):
# DATABASE_URL="postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
DATABASE_URL=""

# --- Minecraft server status ----------------------------------------
# Address shown on the site and queried against mcsrvstat.us for live status.
# Season 6 runs on exaroton — the join address includes a non-default port.
MINECRAFT_SERVER="techstealseason6.exaroton.me"
MINECRAFT_PORT="19457"

# --- Exaroton hosting (server control + admin console) ----------------
# API token from https://exaroton.com/account/ (API tokens) and the server
# id from the panel URL / server settings ("#AbCd…" — the # is optional).
# Without these, the status page falls back to a plain ping and the admin
# console / start-stop controls show "not connected".
EXAROTON_TOKEN=""
EXAROTON_SERVER_ID=""

# --- Supabase Storage (gallery image uploads) -------------------------
# Project URL (https://<ref>.supabase.co) and the secret service-role key
# (Supabase > Settings > API). Server-only — never expose the service role
# key to the client. Create a PUBLIC bucket named "gallery" in the dashboard
# (Storage > New bucket) the first time.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI assistant (optional) ----------------------------------------
# Leave AI_API_KEY empty to run the assistant in "not connected" mode.
# Any OpenAI-compatible /chat/completions endpoint works.
# AI_MODEL is the primary model (defaults to nvidia/nemotron-3.5-super-vl:free,
# the "Fast" entry in src/lib/chat-models.ts).
# AI_FALLBACK_MODELS is a comma-separated ordered fallback chain.
# AI_FALLBACK_MODEL (singular) is a legacy alias, read only when
# AI_FALLBACK_MODELS is unset.
# Defaults: recursive/flint-v1.0:free, then baidu/ernie-5.5-flash-preview:free.
AI_API_KEY=""
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL="nvidia/nemotron-3.5-super-vl:free"
AI_FALLBACK_MODELS="recursive/flint-v1.0:free,baidu/ernie-5.5-flash-preview:free"
# Legacy alias (singular) for the chain above:
# AI_FALLBACK_MODEL=""

# --- Discord OAuth (login) -------------------------------------------
# Create an app at https://discord.com/developers/applications →
# "OAuth2" tab → copy Client ID and Client Secret.
# Redirect URIs to register in the Discord app (both!):
#   http://localhost:3000/api/auth/discord/callback
#   https://www.techsteal.space/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- Discord server verification (onboarding) ------------------------
# Lets users verify they're members of the official server.
#   DISCORD_BOT_TOKEN  — a bot token for an app that's IN your server
#   DISCORD_GUILD_ID   — the server's ID (right-click server → Copy Server ID)
# Without these, onboarding offers "skip" and the profile shows unverified.
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""

# --- App -------------------------------------------------------------
# Canonical public origin used in metadata, Open Graph tags, and the forum RSS
# feed. Leave unset (or empty) to fall back to https://www.techsteal.space in
# src/lib/site.ts. Set it only when the site is served from another origin — a
# wrong value here is baked into metadata and every share card.
# NEXT_PUBLIC_SITE_URL="https://www.techsteal.space"
